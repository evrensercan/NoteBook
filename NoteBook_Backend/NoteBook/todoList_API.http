@NooteBook_API_HostAddress = http://localhost:5087

GET {{NooteBook_API_HostAddress}}/weatherforecast/
Accept: application/json

###
using Microsoft.AspNetCore.Mvc;
using NooteBook_API.Models;
using NooteBook_API.Services;

namespace NooteBook_API.Controllers
{
    [ApiController]
    [Route("[controller]")]
    public class NotController : ControllerBase
    {
        private NotServis _servis = new NotServis(null);

        // CREATE -POST- EKleme
        [HttpPost]
        public IActionResult Create([FromBody] Notes not)
        {
            _servis.Create(not);

            return Ok(new { Message = "Not baþarýyla veritabanýna eklendi!" });
        }

        // READ -GET- Listeleme
        [HttpGet]
        public IActionResult GetAll()
        {
            var notlar = _servis.Listele();

            return Ok(notlar);
        }

        //DELETE
        [HttpDelete("{id}")]
        public IActionResult Delete(int id)
        {
            _servis.Sil(id);
            return Ok(new { Message = id + " numaralý not silindi." });
        }

        //UPDATE-PUT
        [HttpPut("{id}")]
        public IActionResult Update(int id, [FromBody] Notes not)
        {
            // Güvenlik: Dýþarýdan gelen ID ile modelin içindeki ID ayný olsun
            not.Id = id;

            _servis.Guncelle(not);
            return Ok(new { Message = id + " numaralý not güncellendi!" });
        }
    }
}
